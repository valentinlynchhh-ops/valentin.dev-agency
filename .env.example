# Solo nombres de variables. Los valores viven en Vercel (Settings > Environment Variables)
# y en el entorno de cada sesión de Claude Code. Nunca se commitean.

# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://valentin.dev

# WhatsApp público, solo dígitos con código de país (opcional: si falta, no se muestra el botón)
NEXT_PUBLIC_WHATSAPP=

# Supabase (proyecto de valentin.dev). El servidor usa la service role; no es pública.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: avisos de consultas nuevas y mails de salida
RESEND_API_KEY=
# Remitente verificado en Resend, ej: valentin.dev <hola@tu-dominio>
RESEND_FROM=
# Casilla donde llegan los avisos de consultas
ADMIN_EMAIL=

# CRM en /admin
ADMIN_PASSWORD=
# Texto largo y aleatorio para firmar la sesión del CRM
ADMIN_SECRET=

# Rutinas en la nube (cron de Vercel o tareas programadas): secreto que llevan en la cabecera x-cron-secret
CRON_SECRET=

# Outbound: tope diario de mails en frío (por defecto 15) y remitente
OUTBOUND_TOPE_DIA=15

# Solo desarrollo: usa un CRM en memoria sin tocar Supabase (se ignora en producción)
CRM_MODO=
